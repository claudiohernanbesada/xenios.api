# PHP 8.2+ / Apache 2.4; keep the real .env outside Git.
XENIOS_DB_HOST=127.0.0.1
XENIOS_DB_NAME=xeniosDbX
XENIOS_DB_USER=
XENIOS_DB_PASSWORD=
XENIOS_API_TOKEN=
XENIOS_SERVICE_TOKEN=
XENIOS_JWT_SECRET=
XENIOS_WEB_BRIDGE_SECRET=
XENIOS_CORS_ORIGINS=https://app.xenios.com.ar,https://xenios.com.ar,https://www.xenios.com.ar
XENIOS_WEB_BASE_URL=https://app.xenios.com.ar
XENIOS_2FA_BASE_URL=http://127.0.0.1:5090
XENIOS_2FA_BRIDGE_TOKEN=
XENIOS_AVATAR_DIR=/var/storage/avatar
XENIOS_ARTICULOS_DIR=/var/storage/articulos
XENIOS_PERSONAL_DIR=/var/lib/xenios-api/personal
XENIOS_AUTHSALIDA_DIR=/var/storage/authSalida
PATH_LEGAJO_PERSONAL=/var/storage/legajo
URL_LEGAJO_PERSONAL=https://api.xenios.com.ar/legajo
XENIOS_RATE_LIMIT_DIR=/var/lib/xenios-api/rate-limit
XENIOS_PASSWORD_RESET_URL=https://api.xenios.com.ar/xenios-movil/reset-password
XENIOS_APP_LOGIN_URL=xenios://login
XENIOS_MAIL_FROM=noreply@xenios.com.ar
XENIOS_MAIL_DISPLAY_NAME=Xenios
XENIOS_SMTP_HOST=
XENIOS_SMTP_PORT=587
XENIOS_SMTP_USERNAME=
XENIOS_SMTP_PASSWORD=
XENIOS_SMTP_SSL=true
XENIOS_SMTP_ENCRYPTION=tls
XENIOS_FCM_SERVICE_ACCOUNT_FILE=/etc/xenios/firebase-service-account.json
XENIOS_FCM_PROJECT_ID=
XENIOS_APNS_KEY_FILE=
XENIOS_APNS_KEY_ID=
XENIOS_APNS_TEAM_ID=
XENIOS_APNS_TOPIC=ar.com.xenios.app
EXPO_PUBLIC_APP_VERSION=1.0.0

XENIOS_COMPROBANTES_DIR=/var/storage/comprobantes
XENIOS_FACTURAS_DIR=/var/storage/facturas
XENIOS_ORDEN_PAGO_DIR=/var/storage/ordenPago
